*{box-sizing:border-box}
:root{font-family:Inter,system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;color:#111827;background:#f6f8fb}
body{margin:0;min-width:320px}
button,input,select{font:inherit}
button{cursor:pointer}
.admin-shell{min-height:100vh;display:flex;background:#f6f8fb}
.sidebar{width:250px;background:#fff;border-right:1px solid #e6eaf0;display:flex;flex-direction:column;position:fixed;inset:0 auto 0 0;z-index:20}
.brand{height:76px;display:flex;align-items:center;gap:12px;padding:0 20px;border-bottom:1px solid #edf0f4}
.brand-mark{width:38px;height:38px;border-radius:11px;background:#1769e0;color:#fff;display:grid;place-items:center;font-size:20px;font-weight:800}
.brand strong{display:block;font-size:18px;letter-spacing:.5px}
.brand span{display:block;color:#8a94a6;font-size:11px;margin-top:2px}
.nav{padding:14px 10px;overflow:auto;flex:1}
.nav-item{width:100%;border:0;background:transparent;color:#687386;display:flex;align-items:center;gap:11px;text-align:left;padding:11px 12px;border-radius:9px;margin:2px 0;font-size:13px;font-weight:600}
.nav-item:hover{background:#f3f6fa;color:#111827}
.nav-item.active{background:#eaf2ff;color:#1769e0}
.nav-icon{width:22px;text-align:center;font-size:16px}
.profile-mini{border-top:1px solid #edf0f4;padding:14px 16px;display:flex;align-items:center;gap:10px}
.admin-avatar{width:34px;height:34px;border-radius:50%;background:#111827;color:#fff;display:grid;place-items:center;font-weight:700}
.profile-mini strong,.profile-mini span{display:block}
.profile-mini strong{font-size:12px}
.profile-mini span{font-size:11px;color:#8a94a6;margin-top:2px}
.main{margin-left:250px;min-width:0;width:calc(100% - 250px)}
.topbar{height:76px;background:#fff;border-bottom:1px solid #e6eaf0;display:flex;align-items:center;justify-content:space-between;padding:0 28px;position:sticky;top:0;z-index:10}
.topbar-left{display:flex;align-items:center;gap:13px}
.topbar-left strong{display:block;font-size:15px}
.topbar-left span{display:block;color:#8a94a6;font-size:11px;margin-top:3px}
.menu-button{display:none;border:0;background:#f2f5f9;border-radius:8px;width:38px;height:38px}
.connection-dot{padding:7px 10px;border-radius:20px;background:#f4f6f8;color:#7a8494;font-size:11px}
.content{padding:28px;max-width:1500px;margin:auto}
.welcome,.page-heading{display:flex;align-items:flex-start;justify-content:space-between;gap:20px;margin-bottom:22px}
.welcome h1,.page-heading h1{margin:3px 0 7px;font-size:27px;letter-spacing:-.5px}
.welcome p:not(.eyebrow),.page-heading p:not(.eyebrow){margin:0;color:#748094;font-size:13px}
.eyebrow{font-size:10px!important;font-weight:800!important;color:#1769e0!important;letter-spacing:1.1px!important;margin:0!important}
.status-pill,.backend-badge{display:inline-flex;align-items:center;white-space:nowrap;background:#eef5ff;color:#1769e0;border:1px solid #d9e8ff;border-radius:20px;padding:7px 10px;font-size:10px;font-weight:700}
.summary-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:14px;margin-bottom:20px}
.summary-card{background:#fff;border:1px solid #e6eaf0;border-radius:12px;padding:17px}
.summary-card span{display:block;color:#7d8798;font-size:11px}
.summary-card strong{display:block;font-size:24px;margin-top:8px}
.dashboard-grid{display:grid;grid-template-columns:1.1fr .9fr;gap:18px}
.panel,.page-card{background:#fff;border:1px solid #e6eaf0;border-radius:14px;padding:22px}
.panel-head{display:flex;justify-content:space-between;margin-bottom:17px}
.panel-head h3{margin:0;font-size:15px}
.panel-head p{margin:4px 0 0;color:#8a94a6;font-size:11px}
.quick-actions{display:grid;gap:9px}
.quick-actions button{border:1px solid #e5e9ef;background:#fff;border-radius:9px;padding:12px 13px;display:flex;justify-content:space-between;text-align:left;font-size:12px;font-weight:600;color:#273142}
.quick-actions button:hover{border-color:#b9d2f8;background:#f8fbff}
.system-list{display:grid;gap:0}
.system-list div{display:flex;justify-content:space-between;padding:13px 0;border-bottom:1px solid #edf0f4;font-size:12px}
.system-list b{font-size:11px;color:#8a94a6}
.toolbar{display:flex;gap:10px;margin:20px 0}
.toolbar input,.toolbar select{height:40px;border:1px solid #dfe4eb;border-radius:8px;background:#fff;padding:0 12px;color:#3d4757;font-size:12px;outline:none}
.toolbar input{flex:1;min-width:150px}
.toolbar input:focus,.toolbar select:focus{border-color:#1769e0}
.empty-state{border:1px dashed #d7dde6;border-radius:12px;padding:42px 20px;text-align:center;background:#fbfcfe}
.empty-state strong{display:block;font-size:14px}
.empty-state span{display:block;color:#8a94a6;font-size:12px;margin-top:6px}
.info-box{margin-top:18px;background:#f8fbff;border:1px solid #dceaff;border-radius:10px;padding:15px}
.info-box strong{font-size:12px}
.info-box p{margin:6px 0 0;color:#6e7889;font-size:12px;line-height:1.5}
.mobile-backdrop{display:none}
@media(max-width:1000px){
.sidebar{width:220px}
.main{margin-left:220px;width:calc(100% - 220px)}
.summary-grid{grid-template-columns:repeat(2,1fr)}
.dashboard-grid{grid-template-columns:1fr}
}
@media(max-width:760px){
.sidebar{transform:translateX(-100%);transition:transform .2s;width:270px}
.sidebar.open{transform:translateX(0)}
.main{margin-left:0;width:100%}
.menu-button{display:block}
.mobile-backdrop{display:block;position:fixed;inset:0;background:rgba(0,0,0,.25);border:0;z-index:15}
.topbar{padding:0 16px}
.content{padding:17px 14px}
.welcome,.page-heading{flex-direction:column}
.summary-grid{grid-template-columns:repeat(2,1fr);gap:9px}
.summary-card{padding:13px}
.summary-card strong{font-size:20px}
.toolbar{flex-direction:column}
.toolbar input,.toolbar select{width:100%}
.page-card,.panel{padding:16px}
}
@media(max-width:430px){
.summary-grid{grid-template-columns:1fr 1fr}
.welcome h1,.page-heading h1{font-size:23px}
.topbar-right{display:none}
}

.posts-table-wrap{width:100%;overflow-x:auto;border:1px solid #e6eaf0;border-radius:11px}
.posts-table{width:100%;min-width:820px;border-collapse:collapse;background:#fff}
.posts-table th{padding:12px 14px;text-align:left;font-size:10px;letter-spacing:.5px;color:#7d8798;background:#fafbfc;border-bottom:1px solid #e6eaf0}
.posts-table td{padding:13px 14px;border-bottom:1px solid #edf0f4;font-size:12px;color:#4b5565;vertical-align:middle}
.posts-table tbody tr:last-child td{border-bottom:0}
.post-placeholder strong,.post-placeholder span{display:block}
.post-placeholder strong{font-size:12px;color:#202938}
.post-placeholder span{font-size:10px;color:#929baa;margin-top:3px}
.status-badge{display:inline-flex;padding:5px 8px;border-radius:14px;background:#f2f4f7;color:#7d8798;font-size:10px;font-weight:700}
.view-button{border:1px solid #dfe4eb;background:#fff;border-radius:7px;padding:6px 10px;font-size:10px}
.demo-notice{margin-top:14px;padding:11px 13px;border-radius:9px;background:#fafbfc;color:#7d8798;font-size:11px}
@media(max-width:760px){.posts-table-wrap{margin-left:-2px;margin-right:-2px}.posts-table{min-width:760px}}
