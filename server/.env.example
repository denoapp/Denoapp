# DeenoLink B2 media service - environment template
#
# Copy to server/.env and fill in the two B2 values:
#     cp server/.env.example server/.env
#
# server/.env is gitignored. NEVER commit real values, and NEVER put them in
# the Android project (app/), gradle.properties, local.properties, or
# google-services.json.

# ---------------------------------------------------------------------------
# REQUIRED - the only two you must fill in
# ---------------------------------------------------------------------------
# B2 "Key ID" from the Backblazeb2 web UI > Account > Application Keys.
B2_KEY_ID=

# B2 "Application Key" for the same key. Read/Write, scoped to deenolink-media.
B2_APPLICATION_KEY=

# ---------------------------------------------------------------------------
# REQUIRED - which Firebase project issued the caller's ID token
# ---------------------------------------------------------------------------
# Without this the server cannot validate tokens and will not start.
FIREBASE_PROJECT_ID=

# ---------------------------------------------------------------------------
# OPTIONAL - chat push (FCM). Off unless you turn it on.
# ---------------------------------------------------------------------------
# When PUSH_ENABLED is false (the default) POST /v1/push/send answers 503 and
# sends nothing. That is deliberate: a server that cannot deliver must say so
# rather than report a delivery that never happened.
#
# PUSH_ENABLED=true
#
# The whole service-account JSON as ONE line, with real newlines inside the
# private key written as \n. Mint it from the Firebase console > Project settings
# > Service accounts > Generate new private key, then flatten it, e.g.:
#   FIREBASE_SERVICE_ACCOUNT_JSON=$(jq -c . /path/to/service-account.json)
# The key is a full private key: server-only, gitignored, and never readable by
# the Android app. Enabling push without it is a startup error.
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"your-project-id","private_key_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"firebase-adminsdk-...@your-project-id.iam.gserviceaccount.com","client_id":"...","auth_uri":"https://accounts.google.com/o/oauth2/auth","token_uri":"https://oauth2.googleapis.com/token"}

# ---------------------------------------------------------------------------
# GROUPS - group creation and membership
# ---------------------------------------------------------------------------
# Every group membership change goes through this server, and the Firestore
# rules refuse a client that tries to do it itself. The reason is one specific
# check the rules cannot express: a member id is only admitted if a
# users/{uid} profile document really exists. Without list iteration the rules
# could not evaluate that and the write failed closed, so the roster could
# never be changed at all. The service makes the check with the service
# account and writes memberIds, adminIds and memberCount itself, which is also
# what keeps the count equal to the list.
#
# When GROUPS_ENABLED is false (the default) the three group routes answer 503
# and write nothing. Turning it on without FIREBASE_SERVICE_ACCOUNT_JSON above
# is a startup error, because the service has no way to check an id.
#
# The routes, all requiring a Firebase ID token:
#   POST /v1/groups                 { name, description, topic, memberIds }
#   POST /v1/groups/members/add     { groupId, memberIds }
#   POST /v1/groups/members/remove  { groupId, memberId }
# Leaving a group is the remove route with the caller's own uid in memberId.
# GROUPS_ENABLED=true

# ---------------------------------------------------------------------------
# OPTIONAL - shown here with the correct defaults; uncomment to override
# ---------------------------------------------------------------------------
# B2_BUCKET=deenolink-media
# B2_REGION=us-east-005
# B2_ENDPOINT=https://s3.us-east-005.backblazeb2.com
# B2_OBJECT_PREFIX=media
# B2_PRESIGN_TTL_SECONDS=900
# B2_MAX_UPLOAD_BYTES=5242880
# 1-to-1 chat attachments have their own ceiling: a voice note or a short video
# is legitimately larger than a 5 MB avatar. It may not be set BELOW
# B2_MAX_UPLOAD_BYTES, or the server refuses to start.
# B2_MAX_CHAT_UPLOAD_BYTES=26214400
# The default allow-list covers image, video, audio and document types. Overriding
# it replaces the whole list, so keep every type your chat attachments need
# (audio/mp4 is the one a voice note uses).
# B2_ALLOWED_CONTENT_TYPES=image/jpeg,image/png,image/webp,image/heic,image/heif,image/gif,image/bmp,video/mp4,video/quicktime,video/webm,video/3gpp,video/x-matroska,audio/mp4,audio/aac,audio/ogg,audio/webm,audio/mpeg,audio/3gpp,audio/amr,audio/wav,audio/x-wav,application/pdf,application/zip,application/x-zip-compressed,application/json,application/msword,application/vnd.ms-excel,application/vnd.ms-powerpoint,application/vnd.openxmlformats-officedocument.wordprocessingml.document,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet,application/vnd.openxmlformats-officedocument.presentationml.presentation,application/octet-stream,text/plain,text/csv
# B2_CORS_ALLOWED_ORIGINS=https://admin.your-domain.example
# PORT=8787
# HOST=0.0.0.0
# DENO_ENV=production

# Local development only. Refuses to start when DENO_ENV=production.
# B2_ALLOW_ANONYMOUS_DEV=true
# B2_DEV_UID=local-dev-user
